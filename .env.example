# Core
MODE=backup
LIGHTSAIL_SERVICE_NAME=your-backup-service
LIGHTSAIL_CONTAINER_NAME=your-backup-container
# Must be a Postgres dump/restore image that speaks the environment variables below.
DOCKER_IMAGE=your-registry/your-postgres-backup-image:latest
CONTAINER_POWER=medium
CONTAINER_SCALE=1

# Postgres example
DB_HOST=your-database-host
DB_PORT=5432
DB_NAME=your-database
DB_USER=your-database-user
DB_USERPASSWORD=changeme
DB_ROOTUSER=your-database-root-user
DB_ROOTPASSWORD=changeme
PGDATABASE=postgres

# MySQL example (comment out the Postgres block above and use these values instead)
# The image must implement MySQL dump/restore with the same environment contract
# that your container expects. Postgres-only vars are ignored if image is MySQL.
# DOCKER_IMAGE=your-registry/your-mysql-backup-image:latest
# DB_HOST=your-database-host
# DB_PORT=3306
# DB_NAME=your-database
# DB_USER=your-database-user
# DB_USERPASSWORD=changeme
# DB_ROOTUSER=your-database-root-user
# DB_ROOTPASSWORD=changeme
# PGDATABASE=postgres  # ignored if image is MySQL

# AWS
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=changeme
AWS_REGION=us-east-1
S3_BUCKET=your-bucket
S3_BUCKET_PREFIX=database-backups

# Optional Backblaze B2
B2_APPLICATION_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=changeme
B2_BUCKET=your-b2-bucket
B2_HOST=your-b2-s3-endpoint

# Optional observability
SENTRY_DSN=https://your-sentry-dsn
APP_ENV=prod

# Monitor
MONITOR_WEBHOOK_URL=https://your-monitor-webhook.m.pipedream.net
POLLING_INTERVAL_SECONDS=60
MAX_POLLING_ATTEMPTS=40
MAX_POLLING_DURATION_MINUTES=45
INITIAL_DELAY_SECONDS=300
DESTROY_ON_COMPLETION=true
